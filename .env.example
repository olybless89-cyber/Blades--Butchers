# Copy to .env for local development (never commit .env).
# On Railway, set these under the service's Variables tab instead.

# Railway: reference the Postgres service → ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bladeos

# Random 32+ character string. Generate with: openssl rand -hex 32
JWT_SECRET=

# First Owner account — created once, on first boot, if no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Jeffrey

# Break-glass only: clears two-step sign-in for this email on the next boot (lost phone AND recovery codes).
# Remove it again straight after signing in.
# RESET_MFA_FOR=

# Off-site backups (daily, encrypted, restore-tested monthly). Any S3-compatible storage in a
# different company from Railway: Cloudflare R2, Backblaze B2, AWS S3, Wasabi.
#   R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto
#   B2: endpoint https://s3.<region>.backblazeb2.com, region e.g. eu-central-003
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=bladeos/
# 12+ characters. Keep a copy OUTSIDE Railway (password manager / sealed envelope) — without it backups can't be opened.
# BACKUP_PASSPHRASE=
# BACKUP_RETENTION_DAYS=35
